        "jsCode": "const rawData = $input.item.json.body || $input.item.json;\n\nif (!rawData || !rawData.email || !rawData.email.includes('@')) {\n  throw new Error(\"Invalid or missing email address in incoming lead.\");\n}\n\nconst cleanName = (rawData.full_name || 'Prospect').trim();\nconst cleanEmail = rawData.email.toLowerCase().trim();\nconst cleanCompany = (rawData.company_name || 'N/A').trim();\nlet cleanWebsite = (rawData.company_website || '').trim();\n\nif (cleanWebsite && !cleanWebsite.startsWith('http')) {\n  cleanWebsite = 'https://' + cleanWebsite;\n}\n\nreturn {\n  json: {\n    full_name: cleanName,\n    email: cleanEmail,\n    company_name: cleanCompany,\n    company_website: cleanWebsite,\n    processed_at: new Date().toISOString()\n  }\n};"
      },
